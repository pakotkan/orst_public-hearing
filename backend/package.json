{
  "name": "orst-feedback-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --watch prisma --ext ts,prisma --exec \"bunx prisma generate && bun src/index.ts\"",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.3.0",
    "@prisma/client": "^6.0.0",
    "elysia": "^1.3.0",
    "prisma": "^6.0.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/sanitize-html": "^2.16.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.0"
  }
}
