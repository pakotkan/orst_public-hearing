# Copy to .env and change every value marked CHANGE_ME before deploying.

# Host port Nginx listens on
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=public-hearing

# Session signing secret, generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# Admin account created (or promoted) on API startup
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
